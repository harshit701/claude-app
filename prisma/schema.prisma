generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Priority {
  low
  medium
  high
}

model Task {
  // gen_random_uuid() is built into Postgres core as of version 13 — no
  // pgcrypto extension needed on 13+, but older Postgres instances will fail.
  id          String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title       String
  description String?
  completed   Boolean    @default(false)
  priority    Priority   @default(medium)
  dueDate     DateTime?  @map("due_date")
  categories  Category[]
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  @@map("tasks")
}

model Category {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String   @unique
  tasks     Task[]
  createdAt DateTime @default(now()) @map("created_at")

  @@map("categories")
}
